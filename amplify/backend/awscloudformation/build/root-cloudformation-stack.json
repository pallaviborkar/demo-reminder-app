{
  "Description": "Root Stack for AWS Amplify Console",
  "AWSTemplateFormatVersion": "2010-09-09",
  "Parameters": {
    "DeploymentBucketName": {
      "Type": "String",
      "Default": "DeploymentBucket",
      "Description": "Name of the common deployment bucket provided by the parent stack"
    },
    "AuthRoleName": {
      "Type": "String",
      "Default": "AuthRoleName",
      "Description": "Name of the common deployment bucket provided by the parent stack"
    },
    "UnauthRoleName": {
      "Type": "String",
      "Default": "UnAuthRoleName",
      "Description": "Name of the common deployment bucket provided by the parent stack"
    }
  },
  "Outputs": {
    "Region": {
      "Description": "CloudFormation provider root stack Region",
      "Value": {
        "Ref": "AWS::Region"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-Region"
        }
      }
    },
    "StackName": {
      "Description": "CloudFormation provider root stack ID",
      "Value": {
        "Ref": "AWS::StackName"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-StackName"
        }
      }
    },
    "StackId": {
      "Description": "CloudFormation provider root stack name",
      "Value": {
        "Ref": "AWS::StackId"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-StackId"
        }
      }
    },
    "AuthRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "AuthRole",
          "Arn"
        ]
      }
    },
    "UnauthRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "UnauthRole",
          "Arn"
        ]
      }
    },
    "DeploymentBucketName": {
      "Description": "CloudFormation provider root stack deployment bucket name",
      "Value": {
        "Ref": "DeploymentBucketName"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-DeploymentBucketName"
        }
      }
    },
    "AuthRoleName": {
      "Value": {
        "Ref": "AuthRole"
      }
    },
    "UnauthRoleName": {
      "Value": {
        "Ref": "UnauthRole"
      }
    }
  },
  "Resources": {
    "DeploymentBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": {
          "Ref": "DeploymentBucketName"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        }
      },
      "UpdateReplacePolicy": "Retain",
      "DeletionPolicy": "Retain"
    },
    "DeploymentBucketBlockHTTP": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "DeploymentBucketName"
        },
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "s3:*",
              "Effect": "Deny",
              "Principal": "*",
              "Resource": [
                {
                  "Fn::Join": [
                    "",
                    [
                      "arn:aws:s3:::",
                      {
                        "Ref": "DeploymentBucketName"
                      },
                      "/*"
                    ]
                  ]
                },
                {
                  "Fn::Join": [
                    "",
                    [
                      "arn:aws:s3:::",
                      {
                        "Ref": "DeploymentBucketName"
                      }
                    ]
                  ]
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": false
                }
              }
            }
          ]
        }
      }
    },
    "AuthRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "",
              "Effect": "Deny",
              "Principal": {
                "Federated": "cognito-identity.amazonaws.com"
              },
              "Action": "sts:AssumeRoleWithWebIdentity"
            }
          ]
        },
        "RoleName": {
          "Ref": "AuthRoleName"
        }
      }
    },
    "UnauthRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "",
              "Effect": "Deny",
              "Principal": {
                "Federated": "cognito-identity.amazonaws.com"
              },
              "Action": "sts:AssumeRoleWithWebIdentity"
            }
          ]
        },
        "RoleName": {
          "Ref": "UnauthRoleName"
        }
      }
    },
    "AuthTriggerCustomLambdaStack": {
      "Type": "AWS::CloudFormation::Stack",
      "Properties": {
        "TemplateURL": "https://s3.amazonaws.com/amplify-demoreminderapp-dev-752cf-deployment/amplify-cfn-templates/auth/auth-trigger-cloudformation-template.json",
        "Parameters": {
          "env": "dev",
          "userpoolId": {
            "Fn::GetAtt": [
              "authreminderappuserpool",
              "Outputs.UserPoolId"
            ]
          },
          "userpoolArn": {
            "Fn::GetAtt": [
              "authreminderappuserpool",
              "Outputs.UserPoolArn"
            ]
          },
          "functionreminderappuserpoolPostConfirmationLambdaExecutionRole": {
            "Fn::GetAtt": [
              "functionreminderappuserpoolPostConfirmation",
              "Outputs.LambdaExecutionRoleArn"
            ]
          },
          "functionreminderappuserpoolPostConfirmationArn": {
            "Fn::GetAtt": [
              "functionreminderappuserpoolPostConfirmation",
              "Outputs.Arn"
            ]
          },
          "functionreminderappuserpoolPostConfirmationName": {
            "Fn::GetAtt": [
              "functionreminderappuserpoolPostConfirmation",
              "Outputs.Name"
            ]
          }
        }
      },
      "DependsOn": [
        "authreminderappuserpool",
        "functionreminderappuserpoolPostConfirmation"
      ]
    },
    "apidemoreminderapp": {
      "Type": "AWS::CloudFormation::Stack",
      "Properties": {
        "TemplateURL": "https://s3.amazonaws.com/amplify-demoreminderapp-dev-752cf-deployment/amplify-cfn-templates/api/cloudformation-template.json",
        "Parameters": {
          "AppSyncApiName": "demoreminderapp",
          "DynamoDBBillingMode": "PAY_PER_REQUEST",
          "DynamoDBEnableServerSideEncryption": false,
          "AuthCognitoUserPoolId": {
            "Fn::GetAtt": [
              "authreminderappuserpool",
              "Outputs.UserPoolId"
            ]
          },
          "authRoleName": {
            "Ref": "AuthRoleName"
          },
          "unauthRoleName": {
            "Ref": "UnauthRoleName"
          },
          "S3DeploymentBucket": "amplify-demoreminderapp-dev-752cf-deployment",
          "S3DeploymentRootKey": "amplify-appsync-files/37ad1c7ed112cb501fb7ead94688a33148b4177f",
          "env": "dev"
        }
      }
    },
    "authreminderappuserpool": {
      "Type": "AWS::CloudFormation::Stack",
      "Properties": {
        "TemplateURL": "https://s3.amazonaws.com/amplify-demoreminderapp-dev-752cf-deployment/amplify-cfn-templates/auth/reminderappuserpool-cloudformation-template.json",
        "Parameters": {
          "resourceNameTruncated": "demoreda5f7616",
          "userPoolName": "reminderappuserpool",
          "autoVerifiedAttributes": "email",
          "mfaConfiguration": "OFF",
          "mfaTypes": "SMS Text Message",
          "smsAuthenticationMessage": "Your authentication code is {####}",
          "smsVerificationMessage": "Your verification code is {####}",
          "emailVerificationSubject": "Your verification code",
          "emailVerificationMessage": "Your verification code is {####}",
          "defaultPasswordPolicy": false,
          "passwordPolicyMinLength": 8,
          "passwordPolicyCharacters": "",
          "requiredAttributes": "email",
          "aliasAttributes": "",
          "userpoolClientGenerateSecret": false,
          "userpoolClientRefreshTokenValidity": 30,
          "userpoolClientWriteAttributes": "email",
          "userpoolClientReadAttributes": "email",
          "userpoolClientLambdaRole": "remindda5f7616_userpoolclient_lambda_role",
          "userpoolClientSetAttributes": false,
          "sharedId": "da5f7616",
          "resourceName": "reminderappuserpool",
          "authSelections": "userPoolOnly",
          "useDefault": "manual",
          "usernameAttributes": "email",
          "userPoolGroups": false,
          "adminQueries": false,
          "triggers": "{\"PostConfirmation\":[\"custom\"]}",
          "hostedUI": false,
          "userPoolGroupList": "",
          "serviceName": "Cognito",
          "usernameCaseSensitive": false,
          "useEnabledMfas": true,
          "authRoleArn": {
            "Fn::GetAtt": [
              "AuthRole",
              "Arn"
            ]
          },
          "unauthRoleArn": {
            "Fn::GetAtt": [
              "UnauthRole",
              "Arn"
            ]
          },
          "breakCircularDependency": true,
          "dependsOn": "[object Object]",
          "parentStack": {
            "Ref": "AWS::StackId"
          },
          "permissions": "",
          "authProviders": "",
          "authTriggerConnections": "{\"triggerType\":\"PostConfirmation\",\"lambdaFunctionName\":\"reminderappuserpoolPostConfirmation\"}",
          "env": "dev"
        }
      }
    },
    "customReminderStateMachine": {
      "Type": "AWS::CloudFormation::Stack",
      "Properties": {
        "TemplateURL": "https://s3.amazonaws.com/amplify-demoreminderapp-dev-752cf-deployment/amplify-cfn-templates/custom/ReminderStateMachine-cloudformation-template.json",
        "Parameters": {
          "resourceName": "RemindersStatemachine",
          "functionsendReminderEventfromStepFuntionArn": {
            "Fn::GetAtt": [
              "functionsendReminderEventfromStepFuntion",
              "Outputs.Arn"
            ]
          },
          "env": "dev"
        }
      }
    },
    "functionreminderStreamsTriggerLambdaFun2SendEvent2StepFuntion": {
      "Type": "AWS::CloudFormation::Stack",
      "Properties": {
        "TemplateURL": "https://s3.amazonaws.com/amplify-demoreminderapp-dev-752cf-deployment/amplify-cfn-templates/function/reminderStreamsTriggerLambdaFun2SendEvent2StepFuntion-cloudformation-template.json",
        "Parameters": {
          "deploymentBucketName": "amplify-demoreminderapp-dev-752cf-deployment",
          "s3Key": "amplify-builds/reminderStreamsTriggerLambdaFun2SendEvent2StepFuntion-4a4d2b3248475245696d-build.zip",
          "apidemoreminderappGraphQLAPIIdOutput": {
            "Fn::GetAtt": [
              "apidemoreminderapp",
              "Outputs.GraphQLAPIIdOutput"
            ]
          },
          "apidemoreminderappGraphQLAPIEndpointOutput": {
            "Fn::GetAtt": [
              "apidemoreminderapp",
              "Outputs.GraphQLAPIEndpointOutput"
            ]
          },
          "env": "dev"
        }
      }
    },
    "functionreminderappuserpoolPostConfirmation": {
      "Type": "AWS::CloudFormation::Stack",
      "Properties": {
        "TemplateURL": "https://s3.amazonaws.com/amplify-demoreminderapp-dev-752cf-deployment/amplify-cfn-templates/function/reminderappuserpoolPostConfirmation-cloudformation-template.json",
        "Parameters": {
          "modules": "custom",
          "resourceName": "reminderappuserpoolPostConfirmation",
          "deploymentBucketName": "amplify-demoreminderapp-dev-752cf-deployment",
          "s3Key": "amplify-builds/reminderappuserpoolPostConfirmation-386d3546643854744856-build.zip",
          "env": "dev"
        }
      }
    },
    "functionsendReminderEventfromStepFuntion": {
      "Type": "AWS::CloudFormation::Stack",
      "Properties": {
        "TemplateURL": "https://s3.amazonaws.com/amplify-demoreminderapp-dev-752cf-deployment/amplify-cfn-templates/function/sendReminderEventfromStepFuntion-cloudformation-template.json",
        "Parameters": {
          "cognitoUserPoolId": "ap-south-1_ihgThVSjN",
          "sesFromEmail": "borkar.pallavi.v@gmail.com",
          "timeZone": "Asia/Kolkata",
          "deploymentBucketName": "amplify-demoreminderapp-dev-752cf-deployment",
          "s3Key": "amplify-builds/sendReminderEventfromStepFuntion-2b4f6636415348384378-build.zip",
          "env": "dev"
        }
      }
    }
  }
}